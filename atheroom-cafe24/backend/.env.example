APP_ENV=development
DEMO_MODE=true
# Docker Compose supplies PostgreSQL. SQLite is only for the isolated quick demo.
DATABASE_URL=postgresql+psycopg://studio:change-this-password@localhost:5432/studio
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000
OPERATOR_EMAIL=owner@example.com
# Generate with: python -m app.provision
OPERATOR_PASSWORD_HASH=
TOKEN_ENCRYPTION_KEY=
CAFE24_MALL_ID=
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
CAFE24_REDIRECT_URI=http://localhost:3000/api/cafe24/callback
CAFE24_API_VERSION=2026-09-01
CAFE24_SHOP_NO=1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
STORAGE_BACKEND=local
UPLOAD_DIR=./data/uploads
# For production set STORAGE_BACKEND=s3 and use private S3 or R2 bucket.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Use virtual for new Railway buckets; follow the provider's bucket credentials.
S3_ADDRESSING_STYLE=auto
