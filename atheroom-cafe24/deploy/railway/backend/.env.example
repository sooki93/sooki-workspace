# Paste into Railway service variables, not a shell. Shared by backend and worker.
# Resource names below must match the Railway canvas: Postgres, photos, frontend.
APP_ENV=production
DEMO_MODE=false
DATABASE_URL=${{Postgres.DATABASE_URL}}
FRONTEND_ORIGIN=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}
PUBLIC_BASE_URL=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}
CAFE24_REDIRECT_URI=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}/api/cafe24/callback
OPERATOR_EMAIL=
OPERATOR_PASSWORD_HASH=
TOKEN_ENCRYPTION_KEY=
CAFE24_MALL_ID=
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
CAFE24_API_VERSION=2026-09-01
CAFE24_SHOP_NO=1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=${{photos.ENDPOINT}}
S3_BUCKET=${{photos.BUCKET}}
S3_REGION=${{photos.REGION}}
S3_ACCESS_KEY_ID=${{photos.ACCESS_KEY_ID}}
S3_SECRET_ACCESS_KEY=${{photos.SECRET_ACCESS_KEY}}
S3_ADDRESSING_STYLE=virtual
PORT=8000
